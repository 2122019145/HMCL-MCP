# ── HMCL MCP server configuration ─────────────────────────────────────────────
# All variables are optional; the defaults shown apply when unset.
#
# The server reads process environment variables (there is no auto-loaded .env
# file) — set them in your shell, or in the MCP client config's "env" object,
# or copy this file to .env and source it before starting the server.
# See README.md and docs/setup.md for details.

# HMCL working directory (game root + user data): holds versions/, libraries/,
# assets/, mcpacks/, and the .hmcl/ workspace config.
# Default: ~/.hmcl-mcp
#HMCL_MCP_WORKDIR=

# Directory that holds HMCL.jar, hmcl-agent.jar and the javafx jars.
# Default: <workdir>/hmcl
#HMCL_MCP_HMCL_DIR=

# Java binary used to launch the headless HMCL JVM. Requires JDK 17+ (21 recommended).
# Default: `java` found on PATH
#HMCL_MCP_JAVA=

# Optional CurseForge API key (https://console.curseforge.com). Without it,
# CurseForge modpack search/install is unavailable; Modrinth needs no key.
#HMCL_MCP_CURSEFORGE_API_KEY=

# Agent HTTP port on 127.0.0.1.
# Default: 28501
#HMCL_MCP_AGENT_PORT=28501

# Shared token sent as the X-HMCL-Agent-Token header on every agent request.
# Default: hmcl-mcp
#HMCL_MCP_AGENT_TOKEN=hmcl-mcp
